<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fullscreen, no action bar; the dark-indigo window background doubles as the launch screen. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:colorPrimary">@color/splash_bg</item>
        <item name="android:colorPrimaryDark">@color/splash_bg</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
